{
  "version": 1,
  "description": "サイト全体の設定。言語一覧・データ取得先・リンクなど。",
  "locales": ["ja", "en", "ko"],
  "defaultLocale": "ja",
  "localeStorageKey": "amd.locale",
  "themeStorageKey": "amd.theme",
  "paths": {
    "locales": "locales/{locale}.json",
    "categories": "config/categories.json",
    "monetization": "config/monetization.json",
    "data": "data/dashboard.json"
  },
  "links": {
    "repository": "https://github.com/TokiNoviceProgrammer/ai-market-dashboard"
  },
  "dataSources": [
    { "name": "Alpha Vantage", "url": "https://www.alphavantage.co/documentation/" },
    { "name": "FRED", "url": "https://fred.stlouisfed.org/docs/api/terms_of_use.html" },
    { "name": "SEC EDGAR", "url": "https://www.sec.gov/search-filings/edgar-application-programming-interfaces" },
    { "name": "EDINET", "url": "https://disclosure2dl.edinet-fsa.go.jp/guide/static/disclosure/WEEK0060.html" }
  ]
}
